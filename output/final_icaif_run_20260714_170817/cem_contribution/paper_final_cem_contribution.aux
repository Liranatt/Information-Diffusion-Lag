\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Main portfolio comparison over the single January--June 2026 test period (audit-clean universe, identical costs and mechanics, $6\times 20$ CEM budget, seeds 42--51 for stochastic arms; the fixed default policy is deterministic). Excess is percentage points versus buy-and-hold ($+8.52$ SPY, $+17.59$ QQQ). $>0$ counts seeds with positive excess; $>$ref counts seeds beating the fixed default policy. Sharpe, MaxDD, trades, and one-way trade costs (\$) are medians.}}{7}{table.caption.11}\protected@file@percent }
\newlabel{tab:cemmain}{{4}{7}{Main portfolio comparison over the single January--June 2026 test period (audit-clean universe, identical costs and mechanics, $6\times 20$ CEM budget, seeds 42--51 for stochastic arms; the fixed default policy is deterministic). Excess is percentage points versus buy-and-hold ($+8.52$ SPY, $+17.59$ QQQ). $>0$ counts seeds with positive excess; $>$ref counts seeds beating the fixed default policy. Sharpe, MaxDD, trades, and one-way trade costs (\$) are medians}{table.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Portfolio contribution analysis, January--June 2026. A: selection/execution decomposition (median, IQR, min--max across seeds 42--51; diamonds are deterministic arms). B: matched random-selection test --- 500 monthly-matched draws from the eligible pool under identical fixed execution, versus the observed CEM-selection arm.}}{7}{figure.caption.12}\protected@file@percent }
\newlabel{fig:contribution}{{4}{7}{Portfolio contribution analysis, January--June 2026. A: selection/execution decomposition (median, IQR, min--max across seeds 42--51; diamonds are deterministic arms). B: matched random-selection test --- 500 monthly-matched draws from the eligible pool under identical fixed execution, versus the observed CEM-selection arm}{figure.caption.12}{}}
